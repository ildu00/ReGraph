            "maxTokens": 8192,
            "reasoning": true
          },
          {
            "id": "llama-3.1-70b",
            "name": "Llama 3.1 70B",
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "mistral-large",
